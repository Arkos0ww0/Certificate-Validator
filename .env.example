# Example environment configuration for Certificate Validator

# Database connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YourPasswordHere
DB_NAME=certificate_validator

# Encryption keys (generate securely in production)
AES_KEY=replace_with_32_byte_hex_key   # e.g. 64 hex chars for AES-256
AES_IV=replace_with_16_byte_hex_iv    # e.g. 32 hex chars for 128-bit IV

# Hashing (SHA-256 happens automatically, no key needed)

# Bcrypt settings
BCRYPT_SALT_ROUNDS=10
